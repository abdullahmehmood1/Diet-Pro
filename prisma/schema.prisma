generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  foodLogs  FoodLog[]
  mealPlans MealPlan[]
}

model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FoodLog {
  id       String   @id @default(cuid())
  userId   String
  name     String
  calories Int
  protein  Int?
  carbs    Int?
  fats     Int?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}
